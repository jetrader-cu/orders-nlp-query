# Configuración de Entorno

# Proveedor de LLM a utilizar: 'gemini', 'openai' o 'mock'
LLM_PROVIDER=mock

# Clave de API de Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Clave de API de OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Modelo a utilizar
LLM_MODEL=gemini-2.5-flash

# Ruta a la base de datos DuckDB
DATABASE_PATH=data/orders.duckdb

# Configuración del servidor API
API_HOST=0.0.0.0
API_PORT=8000
