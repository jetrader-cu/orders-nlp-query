# Configuración de Entorno

# Proveedor de LLM a utilizar: 'gemini', 'openai' o 'mock'
LLM_PROVIDER=mock

# Clave de API de Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Clave de API de OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Modelo a utilizar: 'gemini-3.1-flash-lite' (recomendado: gratuito/más barato) o 'gemini-3.8-flash'
LLM_MODEL=gemini-3.1-flash-lite

# Ruta a la base de datos (SQLite por defecto o DuckDB)
DATABASE_PATH=data/orders.db

# Configuración del servidor API
API_HOST=0.0.0.0
API_PORT=8000
